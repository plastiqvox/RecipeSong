# .NET 빌드 결과
bin/
obj/
.vs/
*.user

# Python
ml/.venv/
__pycache__/

# 개인 데이터: 내 라이브러리 소리 임베딩·학습 모델·분석 캐시 (내 iTunes 라이브러리에서 만들어짐)
ml/data/

*.log

# 예전 이름(Crate) 폴더: 편집기가 다시 만들어도 올리지 않는다
src/Crate.*/

# 인스톨러 빌드 결과
installer/out/

# 앱에 넣어 빌드하는 키 (secrets/lastfm.key → 빌드할 때 어셈블리에 들어간다). 공개 저장소라 올리지 않는다
secrets/
