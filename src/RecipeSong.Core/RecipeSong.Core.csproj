<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Windows 전용 (iTunes 라이브러리 · 키를 Windows 계정으로 암호화하는 DPAPI). 대상은 net9.0 이라 어셈블리에 표시해 CA1416 을 정리한다 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="RecipeSong.Core.Lang.%(Filename).json" />
  </ItemGroup>

</Project>
