<UserControl x:Class="RecipeSong.Wpf.ArtistLibraryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RecipeSong.Wpf"
        xmlns:core="clr-namespace:RecipeSong.Core;assembly=RecipeSong.Core">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SoulseekStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:UrlToImage x:Key="AlbumCover" DecodeWidth="128"/>
        <Style x:Key="CatalogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{local:Tr '내 플리 아티스트'}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{local:Tr '좋아하는 곡에서 아티스트를 찾고, 전체 라이브러리와 비교해 놓친 앨범을 찾아요.'}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,6,0,12"/>
            <WrapPanel>
                <ComboBox x:Name="PlaylistBox" Style="{StaticResource SoulseekFormatBox}" Width="240" DisplayMemberPath="Name" SelectionChanged="Playlist_Changed" AutomationProperties.Name="{local:Tr '플레이리스트 선택'}" Margin="0,0,12,8"/>
                <CheckBox x:Name="FollowBox" Content="{local:Tr '팔로우 포함'}" IsChecked="True" Checked="Source_Changed" Unchecked="Source_Changed" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <Button Style="{StaticResource UtilityIconButton}" Click="Reload_Click" Margin="0,0,0,8" ToolTip="{local:Tr '목록 새로고침'}" AutomationProperties.Name="{local:Tr '목록 새로고침'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource RefreshIcon}"/>
                </Button>
            </WrapPanel>
            <TextBlock Text="{local:Tr '아티스트 직접 검색'}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,4,0,5"/>
            <DockPanel MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button x:Name="DirectArtistSearchButton" DockPanel.Dock="Right" Style="{StaticResource UtilityIconButton}" Margin="6,0,0,0" IsEnabled="False"
                        Click="DirectArtistSearch_Click" ToolTip="{local:Tr '아티스트 직접 검색'}" AutomationProperties.Name="{local:Tr '아티스트 직접 검색'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource SearchIcon}"/>
                </Button>
                <TextBox x:Name="DirectArtistQuery" MinWidth="240" MinHeight="36" VerticalContentAlignment="Center" KeyDown="DirectArtistQuery_KeyDown"
                         AutomationProperties.Name="{local:Tr '직접 검색할 아티스트 이름'}" ToolTip="{local:Tr '플리에 없는 아티스트도 이름으로 찾을 수 있어요.'}"/>
            </DockPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource Text2}" Margin="0,0,0,12"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="270"/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBox x:Name="ArtistQuery" DockPanel.Dock="Top" TextChanged="Query_Changed" AutomationProperties.Name="{local:Tr '아티스트 이름 필터'}" ToolTip="{local:Tr '아티스트 이름 필터'}" Margin="0,0,0,8"/>
                <ListBox x:Name="Artists" SelectionChanged="Artist_Changed" AutomationProperties.Name="{local:Tr '내 플리 아티스트'}"
                         ItemContainerStyle="{StaticResource CatalogItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="♪" Foreground="{StaticResource Muted}" FontSize="24" ToolTip="{local:Tr '대표 앨범 정보 없음'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding TopAlbums.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TopAlbums}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Width="24" Height="24" Margin="0,0,2,0" Background="{StaticResource Surface3}" ToolTip="{Binding CoverDescription}">
                                        <Grid>
                                            <TextBlock Text="♪" Foreground="{StaticResource Muted}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CoverUrl, Converter={StaticResource AlbumCover}}" Stretch="UniformToFill"
                                                   Loaded="ArtistCover_Loaded" DataContextChanged="ArtistCover_DataContextChanged" AutomationProperties.Name="{Binding CoverDescription}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   ToolTip="{local:Tr '플리 곡의 취향 가중치 합으로 정렬해요. 동점이면 좋아요 곡 수·재생 수·곡 수·이름순이에요.'}"/>
                        </StackPanel>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource Line}"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="ArtistTitle" Text="{local:Tr '왼쪽에서 아티스트를 골라 주세요.'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <Expander x:Name="PlaylistSongsPanel" Grid.Row="1" Header="{local:Tr '내 플리에 담긴 곡'}" Margin="0,0,0,10"><ListBox x:Name="MySongs" MaxHeight="150" DisplayMemberPath="Title"/></Expander>
                <StackPanel Grid.Row="2">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="FindButton" DockPanel.Dock="Right" Content="{local:Tr '놓친 앨범 찾기'}" Style="{StaticResource Bare}" Click="Find_Click" IsEnabled="False" Padding="12,6" Margin="8,0,0,0"/>
                        <Button x:Name="EditIdentityButton" DockPanel.Dock="Right" Content="{local:Tr 'ID 변경'}" Style="{StaticResource Bare}"
                                Click="EditIdentity_Click" Padding="10,5" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="IdentitySummary" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="IdentityEditor">
                    <TextBlock Text="{local:Tr '동명이인이 아닌지 확인한 뒤 앨범을 불러오세요.'}" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,7,0,8">
                        <Button x:Name="ResetIdentityButton" DockPanel.Dock="Right" Style="{StaticResource Bare}" Content="{local:Tr 'ID 다시 찾기'}" Click="ResetIdentity_Click" IsEnabled="False" Padding="10,5" Margin="8,0,0,0"
                                ToolTip="{local:Tr '이 아티스트의 저장된 ID를 지우고 보유 정보로 다시 대조해요.'}"/>
                        <ComboBox x:Name="CandidateBox" Style="{StaticResource SoulseekFormatBox}" DisplayMemberPath="Label" SelectionChanged="Candidate_Changed" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{local:Tr '검색된 아티스트 선택'}"/>
                    </DockPanel>
                    <StackPanel x:Name="CandidateChoices" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="{local:Tr '아티스트 ID 후보'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListBox x:Name="CandidateList" MaxHeight="150" SelectionChanged="CandidateList_Changed" AutomationProperties.Name="{local:Tr '아티스트 ID 후보'}">
                            <ListBox.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Row="3" Margin="0,0,0,10">
                    <CheckBox x:Name="IncludeOwnedBox" Content="{local:Tr '보유 앨범 포함'}" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,14,6"/>
                    <CheckBox x:Name="AlbumBox" Content="{local:Tr '정규'}" IsChecked="True" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,14,6"/>
                    <CheckBox x:Name="EpBox" Content="EP" IsChecked="True" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,14,6"/>
                    <CheckBox x:Name="SingleBox" Content="{local:Tr '싱글'}" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,14,6"/>
                    <CheckBox x:Name="LiveBox" Content="{local:Tr '라이브 포함'}" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,14,6"/>
                    <CheckBox x:Name="CompilationBox" Content="{local:Tr '컴필레이션 포함'}" Checked="Type_Changed" Unchecked="Type_Changed" Margin="0,0,0,6"/>
                </WrapPanel>
                <DockPanel Grid.Row="4">
                <TextBlock x:Name="CatalogSummary" DockPanel.Dock="Top" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                <ListBox x:Name="Albums" SelectionChanged="Album_Changed" AutomationProperties.Name="{local:Tr '놓친 앨범'}"
                         ItemContainerStyle="{StaticResource CatalogItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" Background="{StaticResource Surface3}" VerticalAlignment="Top">
                            <Grid>
                                <TextBlock Text="♪" Foreground="{StaticResource Muted}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Album.Cover, Converter={StaticResource AlbumCover}}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Title}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,5,0,0">
                                <TextBlock Text="{Binding Metadata}" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <Border BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,0,4" ToolTip="{Binding Summary}">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Line3}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Ownership}" Value="{x:Static core:CatalogOwnership.Missing}"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                                    </Style></Border.Style>
                                    <TextBlock Text="{Binding OwnershipLabel}" Foreground="{StaticResource Text2}" FontSize="11"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
                <Expander Grid.Row="5" Header="{local:Tr '선택한 앨범 수록곡'}" IsExpanded="True" Margin="0,10,0,0"><ListBox x:Name="AlbumSongs" MaxHeight="140"/></Expander>
                <Button Grid.Row="6" x:Name="SearchButton" Content="{local:Tr 'Soulseek 검색·다운로드'}" Style="{StaticResource Bare}" Click="Search_Click" IsEnabled="False" HorizontalAlignment="Right" Padding="14,8" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
