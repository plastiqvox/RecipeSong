<UserControl x:Class="RecipeSong.Wpf.SoulseekSearchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RecipeSong.Wpf">
    <UserControl.Resources><ResourceDictionary Source="SoulseekStyles.xaml"/></UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource UtilityIconButton}" Click="Settings_Click" ToolTip="{local:Tr 'Soulseek 설정'}" AutomationProperties.Name="{local:Tr 'Soulseek 설정'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource GearIcon}" StrokeThickness="0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource UtilityIconButton}" Click="Back_Click" HorizontalAlignment="Left" ToolTip="{local:Tr '추천으로'}" AutomationProperties.Name="{local:Tr '추천으로'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource BackIcon}"/>
                </Button>
            </DockPanel>
            <TextBlock x:Name="AlbumText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExcludedPeerText" Foreground="{StaticResource AccentText}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" x:Name="SearchButton" Style="{StaticResource UtilityIconButton}" Click="Search_Click" Margin="6,0,0,0" ToolTip="{local:Tr '검색'}" AutomationProperties.Name="{local:Tr '검색'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource SearchIcon}"/>
                </Button>
                <TextBox x:Name="QueryBox" AutomationProperties.Name="{local:Tr 'Soulseek 검색어'}" MinHeight="36" VerticalContentAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="StopButton" Style="{StaticResource UtilityIconButton}" Click="Stop_Click" IsEnabled="False" ToolTip="{local:Tr '검색 중지'}" AutomationProperties.Name="{local:Tr '검색 중지'}">
                    <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource StopIcon}" StrokeThickness="0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="DownloadsButton" Style="{StaticResource Bare}" Content="{local:Tr '다운로드 상태 보기'}" Click="Downloads_Click" Padding="12,6" Margin="6,0,0,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="{local:Tr '파일 확장자'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="FormatBox" Style="{StaticResource SoulseekFormatBox}" Width="130" SelectionChanged="Format_Changed" AutomationProperties.Name="{local:Tr '파일 확장자'}" ToolTip="{local:Tr '선택한 확장자의 파일만 표시·다운로드해요.'}"/>
                <TextBlock x:Name="FilterCountText" VerticalAlignment="Center" Foreground="{StaticResource Text2}" FontSize="12" Margin="10,5,0,5"/>
            </WrapPanel>
            <TextBlock x:Name="TrackCountText" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock x:Name="FilterEmptyText" Text="{local:Tr '앨범 곡수와 확장자에 맞는 결과가 없어요. 검색어나 확장자를 바꿔 보세요.'}" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="{local:Tr '대기열 적은 순 · 속도 빠른 순'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary}" FontWeight="Medium" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Peer.Username}" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,4" ToolTip="{local:Tr '검색 응답 당시 상대방의 업로드 슬롯·대기열 정보예요. 내 대기 순번은 아니며 다운로드 요청 시 달라질 수 있어요.'}">
                                    <Border Background="{StaticResource Surface3}" CornerRadius="5" Padding="8,4" Margin="0,0,10,4">
                                        <TextBlock Text="{Binding Availability}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding HasAvailableSlot}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding SlotText}" FontSize="13" Foreground="{StaticResource Text2}" Margin="0,4,10,4" ToolTip="{local:Tr '상대 검색 응답은 빈 슬롯 유무만 알려줘요. 정확한 빈 슬롯 수는 알 수 없어요.'}"/>
                                    <TextBlock Text="{Binding QueueText}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text}" Margin="0,4,0,4"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,2,0,6" ToolTip="{local:Tr '상대가 검색 응답에 보고한 업로드 속도예요. 실제로 내가 받는 속도와 다를 수 있어요.'}"/>
                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" ToolTip="{Binding Folder}"/>
                                <Expander Header="{local:Tr '수록곡 확인·선택'}">
                                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,4">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Foreground="{StaticResource Text}" Margin="0,4"><TextBlock Text="{Binding File.Name}" TextWrapping="Wrap" FontSize="12"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <Button Style="{StaticResource Bare}" Content="{local:Tr '선택한 곡 다운로드'}" Click="Receive_Click" Padding="14,7" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
