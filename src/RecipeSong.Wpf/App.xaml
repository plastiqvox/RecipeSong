<Application x:Class="RecipeSong.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RecipeSong.Wpf">
    <Application.Resources>
        <!-- 색: 디자인 시안(Crate UI)과 같은 값 -->
        <Color x:Key="BgColor">#0F1012</Color>
        <SolidColorBrush x:Key="Bg" Color="#0F1012"/>
        <SolidColorBrush x:Key="Sidebar" Color="#141518"/>
        <SolidColorBrush x:Key="Surface" Color="#17191C"/>
        <SolidColorBrush x:Key="Surface2" Color="#1D1F23"/>
        <SolidColorBrush x:Key="Surface3" Color="#1F2226"/>
        <SolidColorBrush x:Key="Hover" Color="#262A2F"/>
        <SolidColorBrush x:Key="Line" Color="#24272C"/>
        <SolidColorBrush x:Key="Line2" Color="#2A2E33"/>
        <SolidColorBrush x:Key="Line3" Color="#3A3F45"/>
        <SolidColorBrush x:Key="Text" Color="#EDEDEA"/>
        <SolidColorBrush x:Key="Text2" Color="#C9CDD2"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA1A8"/>
        <SolidColorBrush x:Key="Accent" Color="#F0A04B"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFC27A"/>
        <SolidColorBrush x:Key="AccentDeep" Color="#3D2C18"/>
        <SolidColorBrush x:Key="OnAccent" Color="#1A1206"/>
        <SolidColorBrush x:Key="Ok" Color="#6CCB8C"/>
        <!-- AI 커넥터 배지 -->
        <SolidColorBrush x:Key="ClaudeBrush" Color="#E3936B"/>
        <SolidColorBrush x:Key="ClaudeDeep" Color="#33201A"/>
        <SolidColorBrush x:Key="GptBrush" Color="#5FC9A8"/>
        <SolidColorBrush x:Key="GptDeep" Color="#15302A"/>

        <FontFamily x:Key="Sans">Noto Sans KR, Malgun Gothic, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">IBM Plex Mono, Consolas</FontFamily>

        <local:BoolToVisibility x:Key="BoolVis"/>
        <local:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <local:TrFormatConverter x:Key="TrFmt"/>
        <local:EmptyToCollapsed x:Key="EmptyCollapsed"/>
        <local:HeatToBrush x:Key="HeatBrush"/>
        <local:UrlToImage x:Key="Img" DecodeWidth="240"/>
        <local:UrlToImage x:Key="ImgSmall" DecodeWidth="96"/>

        <Geometry x:Key="PlayIcon">M8,5.5 L8,18.5 A1,1 0 0 0 9.5,19.36 L20,12.86 A1,1 0 0 0 20,11.14 L9.5,4.64 A1,1 0 0 0 8,5.5 Z</Geometry>
        <Geometry x:Key="PauseIcon">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</Geometry>
        <!-- 수록곡 목록: 점 + 줄 세 개 -->
        <Geometry x:Key="TracklistIcon">M1,2 L1.1,2 M6,2 H19 M1,8 L1.1,8 M6,8 H19 M1,14 L1.1,14 M6,14 H15</Geometry>
        <!-- Deezer: 높이가 다른 막대 다섯 개 (이퀄라이저 모양) -->
        <Geometry x:Key="DeezerIcon">M0,14 H4 V18 H0 Z M5,10 H9 V18 H5 Z M10,6 H14 V18 H10 Z M15,9 H19 V18 H15 Z M20,2 H24 V18 H20 Z</Geometry>
        <Geometry x:Key="YouTubeIcon">M4,2 H20 A4,4 0 0 1 24,6 V14 A4,4 0 0 1 20,18 H4 A4,4 0 0 1 0,14 V6 A4,4 0 0 1 4,2 Z M9.5,6 V14 L16,10 Z</Geometry>
        <!-- 좋아요: 하트 -->
        <Geometry x:Key="HeartIcon">M12,20.6 L10.7,19.4 C6.1,15.2 3,12.4 3,8.9 C3,6.1 5.2,3.9 8,3.9 C9.6,3.9 11.1,4.6 12,5.8 C12.9,4.6 14.4,3.9 16,3.9 C18.8,3.9 21,6.1 21,8.9 C21,12.4 17.9,15.2 13.3,19.4 Z</Geometry>
        <!-- 앨범 좋아요 · 별로: 엄지 위 · 아래 -->
        <Geometry x:Key="ThumbUpIcon">M7,21 H17 L21,11 V9 H14 L15,4 C15,2.5 13.5,2 13,3 L8,10 H7 Z M3,21 H6 V10 H3 Z</Geometry>
        <Geometry x:Key="ThumbDownIcon">M7,3 H17 L21,13 V15 H14 L15,20 C15,21.5 13.5,22 13,21 L8,14 H7 Z M3,3 H6 V14 H3 Z</Geometry>
        <!-- 웹진 배지: 잡지 (펼친 페이지와 글줄) -->
        <Geometry x:Key="MagazineIcon">M3,4 H15 V20 H5 A2,2 0 0 1 3,18 Z M15,8 H20 V18 A2,2 0 0 1 18,20 H15 M6,8 H12 M6,12 H12 M6,16 H10</Geometry>
        <!-- 내 라이브러리 뮤지션 배지: 줄 + 음표 -->
        <Geometry x:Key="PlaylistIcon">M2,5 H13 M2,10 H13 M2,15 H8 M17,17 A2.5,2.5 0 1 1 16.99,17 M19.5,17 V4 L23,5.5</Geometry>
        <!-- 팔로우: 별 -->
        <Geometry x:Key="StarIcon">M12,2.8 L14.8,8.6 L21.2,9.4 L16.5,13.8 L17.7,20.2 L12,17.1 L6.3,20.2 L7.5,13.8 L2.8,9.4 L9.2,8.6 Z</Geometry>
        <!-- 설정: 톱니바퀴 (Material Icons, Apache 2.0) -->
        <Geometry x:Key="GearIcon">F0 M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</Geometry>
        <!-- Apple Music: 둥근 사각형 안의 8분음표 두 개 (로고가 아닌 일반 음표 모양) -->
        <Geometry x:Key="AppleMusicIcon">F0 M5,0 H19 A5,5 0 0 1 24,5 V19 A5,5 0 0 1 19,24 H5 A5,5 0 0 1 0,19 V5 A5,5 0 0 1 5,0 Z M9.5,6.5 V14.6 A2.6,2.4 0 1 0 11,16.6 V10 L17,8.6 V13.1 A2.6,2.4 0 1 0 18.5,15.1 V4.8 Z</Geometry>
        <Geometry x:Key="BookmarkIcon">M6,3 H18 V21 L12,16.5 L6,21 Z</Geometry>
        <Geometry x:Key="ChevronLeft">M15,18 L9,12 L15,6</Geometry>
        <Geometry x:Key="ChevronRight">M9,18 L15,12 L9,6</Geometry>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 팝업(툴팁·우클릭 메뉴)도 어두운 테마로: 기본 흰 바탕에 위의 흰 글자가 묻히지 않게 -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line3}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,0,6,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line3}" BorderThickness="1"
                                CornerRadius="10" Padding="4" Margin="0,0,6,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,7" MinWidth="170">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource Line3}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 작은 제목: 고정폭 글꼴은 한글이 대체 글꼴로 나와 자간이 벌어져 보여서 본문 글꼴 -->
        <Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- 슬라이더 (재생 위치·볼륨): Windows 기본 네모 손잡이 대신 얇은 줄 + 둥근 손잡이, 지나온 쪽은 밝게 -->
        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 세로 슬라이더용 막대 (수록곡 창 볼륨) -->
        <Style x:Key="SliderPartV" TargetType="RepeatButton" BasedOn="{StaticResource SliderPart}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Width="4" CornerRadius="2" Background="{TemplateBinding Background}" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="done" Style="{StaticResource SliderPart}" Background="{StaticResource Text2}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPart}" Background="{StaticResource Line3}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="{StaticResource Text}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="done" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="MinWidth" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <!-- 세로는 아래가 0 (IsDirectionReversed) -->
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="done" Style="{StaticResource SliderPartV}" Background="{StaticResource Text2}" Command="Slider.DecreaseLarge"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderPartV}" Background="{StaticResource Line3}" Command="Slider.IncreaseLarge"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Background="{StaticResource Text}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="done" Property="Background" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 체크박스: Windows 기본 흰 상자가 어두운 화면에서 튀어서 -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="box" DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{StaticResource Line3}" Background="{StaticResource Surface3}" VerticalAlignment="Top" Margin="0,2,8,0">
                                <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{StaticResource OnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Margin="-1.5" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 키보드 포커스 표시: WPF 기본 점선 대신 주황 둥근 테두리 -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 기본 버튼: 배경 없이, 호버만 (키보드 포커스는 테두리 색으로 보이므로 점선은 끈다) -->
        <Style x:Key="Bare" TargetType="ButtonBase">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 팝업을 여는 토글 (형식·지역 필터) -->
        <Style x:Key="DropToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line2}" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 필터 칩 -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource Line2}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="t" Text="{Binding Label}" Foreground="{StaticResource Text2}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                                <Border x:Name="cb" Margin="8,0,0,0" CornerRadius="8" Padding="6,1" Background="{StaticResource Surface3}"
                                        Visibility="{Binding Count, Converter={StaticResource EmptyCollapsed}}">
                                    <TextBlock x:Name="ct" Text="{Binding Count}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDeep}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource AccentText}"/>
                                <Setter TargetName="cb" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="ct" Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigChip" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- 세그먼트(연/월/주)와 탭: RadioButton -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="7" Background="Transparent">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Medium" Foreground="{StaticResource Text2}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,4,-1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="16,0" Background="Transparent">
                            <ContentPresenter x:Name="c" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Muted}"
                                              TextElement.FontSize="15" TextElement.FontWeight="Medium"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 원형 재생 버튼 -->
        <Style x:Key="RoundPlay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="g" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 어두운 스크롤바 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="4" CornerRadius="2" Background="{StaticResource Line3}" Margin="0,2" HorizontalAlignment="Center"/>  <!-- 손잡이 굵기를 고정 (ScrollViewer 가 스크롤바 칸을 17 로 잡아 칸에 맞추면 굵었다) -->
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 가로 (수록곡 창을 열었을 때 레시피 칩 줄) -->
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="4" CornerRadius="2" Background="{StaticResource Line3}" Margin="2,0" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Line2}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
