<Window x:Class="RecipeSong.Wpf.SoulseekImportWindow" Icon="/RecipeSong.Wpf;component/Assets/logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RecipeSong.Wpf"
        Title="{local:Tr 'Soulseek 설정 가져오기'}" Width="680" Height="580" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}">
    <Window.Resources><ResourceDictionary Source="SoulseekStyles.xaml"/></Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Bare}" Content="{local:Tr '취소'}" IsCancel="True" Padding="16,8"/>
            <Button Style="{StaticResource Bare}" Content="{local:Tr '선택한 설정 가져오기'}" Click="Apply_Click" IsDefault="True" Padding="16,8" Margin="8,0,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{local:Tr 'Soulseek NS 설정'}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{local:Tr '선택한 항목을 설정 칸에 채워요. 저장 버튼을 눌러야 보관하며, 자동으로 로그인하지 않아요.'}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,8,0,20"/>
                <CheckBox x:Name="AccountBox" IsChecked="True" Foreground="{StaticResource Text}" Margin="0,6"/>
                <CheckBox x:Name="PasswordBox" IsChecked="True" Content="{local:Tr '비밀번호 · •••••••• (Windows 계정으로 암호화해 저장)'}" Foreground="{StaticResource Text}" Margin="0,6"/>
                <CheckBox x:Name="DownloadsBox" IsChecked="True" Foreground="{StaticResource Text}" Margin="0,14,0,6">
                    <StackPanel><TextBlock Text="{local:Tr '원본 다운로드 폴더'}"/><TextBlock x:Name="DownloadPathText" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </CheckBox>
                <TextBlock Text="{local:Tr '업로드·공유 폴더'}" Style="{StaticResource Kicker}" Margin="0,20,0,8"/>
                <TextBlock x:Name="ReviewHint" Text="{local:Tr '기존 공유 권한을 확인할 수 없는 폴더가 있어요. 공개해도 되는 폴더만 선택하세요.'}" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" Margin="0,0,0,10" Visibility="Collapsed"/>
                <ItemsControl x:Name="FolderChoices">
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Foreground="{StaticResource Text}" Margin="0,5"><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
