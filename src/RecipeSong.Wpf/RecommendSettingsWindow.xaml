<Window x:Class="RecipeSong.Wpf.RecommendSettingsWindow" Icon="/Assets/logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RecipeSong.Wpf"
        Title="{local:Tr '추천 설정'}" Width="800" Height="680" MinWidth="720" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Sans}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- 제목·탭·저장 버튼은 고정하고 각 탭 본문만 스크롤한다. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="28,14,28,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Bare}" Padding="18,8" IsCancel="True">
                    <TextBlock Text="{local:Tr '취소'}" Foreground="{StaticResource Text2}"/>
                </Button>
                <Button Style="{StaticResource Bare}" Padding="18,8" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"
                        Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}">
                    <TextBlock Text="{local:Tr '저장하고 다시 찾기'}" Foreground="{StaticResource OnAccent}" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="28,24,28,18">
            <TextBlock Text="{local:Tr '추천 설정'}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{local:Tr '변경 사항은 저장할 때 적용돼요.'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" Style="{StaticResource WorkspaceTabs}">
            <TabItem Header="{local:Tr '추천 방식'}" Style="{StaticResource WorkspaceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18,28,24">
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr '추가 제안은 Deezer의 비슷한 아티스트 연결망으로 후보를 모으고, 내 PC의 소리 모델이 내 곡과 닮은 정도로 고릅니다. 내 아카이브에서 많이 듣는 뮤지션의 발매작은 이 설정과 상관없이 항상 나와요.'}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{local:Tr '추천 양'}" Style="{StaticResource Kicker}" Margin="0,24,0,8"/>
                                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                                    <UniformGrid x:Name="AmountGrid" Rows="1"/>
                                </Border>
                                <TextBlock x:Name="AmountHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="{local:Tr '모험 정도'}" Style="{StaticResource Kicker}" Margin="0,22,0,8"/>
                                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                                    <UniformGrid x:Name="AdventureGrid" Rows="1"/>
                                </Border>
                                <TextBlock x:Name="AdventureHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Tr '앨범에서 들을 곡'}" Style="{StaticResource Kicker}" Margin="0,22,0,8"/>
                                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                                    <UniformGrid x:Name="TracksGrid" Rows="1"/>
                                </Border>
                                <TextBlock x:Name="TracksHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <StackPanel x:Name="CalculationOptions" Margin="0,24,0,0">
                                    <TextBlock Text="{local:Tr '계산 방식'}" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="UsePreciseBox" Content="{local:Tr '주별로 촘촘히 계산'}" Foreground="{StaticResource Text}" FontSize="14"
                                              AutomationProperties.Name="{local:Tr '주별로 촘촘히 계산'}"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                               Text="{local:Tr '기본으로 켜져 있어요. 월·연에서 다시 계산하거나 저장하고 다시 찾을 때 주별로 계산해요. 저장된 주는 건너뛰고, 주 보기는 일반 계산을 사용해요.'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Tr '제외 설정'}" Style="{StaticResource WorkspaceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18,28,24">
                        <CheckBox x:Name="ExcludeKnownBox" Margin="0,20,0,0" Foreground="{StaticResource Text}" FontSize="14"
                                  Content="{local:Tr '추가 제안에서 아는 아티스트 빼기 (처음 듣는 사람만)'}"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr '내 아카이브에 곡이 있는 아티스트는 추가 제안에 나오지 않아요. 내 아카이브 뮤지션과 AI 제안은 그대로 나와요.'}"/>

                        <CheckBox x:Name="ExcludeInstrumentalBox" Margin="0,16,0,0" Foreground="{StaticResource Text}" FontSize="14"
                                  Content="{local:Tr '원래 앨범이 있으면 인스트루멘털 버전 빼기'}"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr '같은 아티스트의 원래 앨범이 Deezer나 내 아카이브에 있으면 (Instrumental) · (Inst.) 버전은 추천하지 않아요.'}"/>

                        <CheckBox x:Name="ExcludeLiveBox" Margin="0,16,0,0" Foreground="{StaticResource Text}" FontSize="14"
                                  Content="{local:Tr '라이브판 빼기'}"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr '제목에 Live · Live at · (Live in …) · ライブ · 라이브가 들어간 공연 녹음은 추천에 보이지 않아요. 다시 계산하지 않아도 바로 숨겨져요.'}"/>

                        <CheckBox x:Name="ExcludeRemixBox" Margin="0,16,0,0" Foreground="{StaticResource Text}" FontSize="14"
                                  Content="{local:Tr '리믹스 빼기'}"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Text="{local:Tr '제목에 Remix · Remixes · Remixed가 들어간 발매작은 추천에 보이지 않아요. 원곡 싱글·앨범은 그대로 나와요.'}"/>

                        <TextBlock Text="{local:Tr '관심 없음·차단과 아주 닮은 추천'}" Style="{StaticResource Kicker}" Margin="0,22,0,8"/>
                        <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                            <UniformGrid x:Name="DropGrid" Rows="1"/>
                        </Border>
                        <TextBlock x:Name="DropHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Tr '웹진'}" Style="{StaticResource WorkspaceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18,28,24">
                        <!-- 외부 추천: 웹진 -->
                        <DockPanel Margin="0,20,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bare}" Padding="12,5" Click="RefreshWebzines_Click">
                                <TextBlock x:Name="WebzineRefreshText" Text="{local:Tr '지금 새로 읽기'}" FontSize="12" Foreground="{StaticResource Text2}"/>
                            </Button>
                            <TextBlock Text="{local:Tr '외부 추천 · 웹진 (RSS)'}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{local:Tr '웹진이 소개한 앨범을 6시간마다 가져와 Deezer에서 확인하고, 발매 주를 열면 보라색 잡지 배지로 보여 줘요. 국내 웹진은 RSS를 막아 두거나 제공하지 않아 아직 없어요.'}"/>
                        <WrapPanel x:Name="WebzinePanel"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Tr '팔로우·차단'}" Style="{StaticResource WorkspaceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,18,28,24">
                        <!-- 팔로우 -->
                        <!-- 제목 · 개수 · (많으면) 이름 찾기를 한 줄에 -->
                        <DockPanel Margin="0,20,0,8">
                            <Grid DockPanel.Dock="Right" Width="180" x:Name="FollowFilterBox" Visibility="Collapsed">
                                <TextBox x:Name="FollowFilter" Background="{StaticResource Surface3}" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                                         BorderBrush="{StaticResource Line3}" BorderThickness="1" Padding="8,4" FontSize="12" TextChanged="Filter_Changed"
                                         AutomationProperties.Name="{local:Tr '팔로우한 아티스트 찾기'}"/>
                                <TextBlock x:Name="FollowFilterHint" Text="{local:Tr '이름으로 찾기'}" Style="{StaticResource MutedText}" FontSize="12" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock Text="{local:Tr '팔로우한 아티스트'}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FollowCount" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="FollowEmpty" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                   Text="{local:Tr '아직 없어요. 카드의 아티스트 이름 앞 ☆을 누르면 그 아티스트 발매작을 항상 맨 앞에 보여 줘요.'}"/>
                        <StackPanel x:Name="FollowNoResults" Visibility="Collapsed" Margin="0,4,0,8">
                            <TextBlock Text="{local:Tr '검색 결과가 없어요.'}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            <Button Content="{local:Tr '검색어 지우기'}" Style="{StaticResource Bare}" Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ClearFollowFilter_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="FollowPanel"/>

                        <!-- 차단 목록 -->
                        <Border Height="1" Background="{StaticResource Line2}" Margin="0,26,0,0"/>
                        <!-- 제목 · 개수 · (많으면) 이름 찾기를 한 줄에 -->
                        <DockPanel Margin="0,20,0,8">
                            <Grid DockPanel.Dock="Right" Width="180" x:Name="BlockedFilterBox" Visibility="Collapsed">
                                <TextBox x:Name="BlockedFilter" Background="{StaticResource Surface3}" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                                         BorderBrush="{StaticResource Line3}" BorderThickness="1" Padding="8,4" FontSize="12" TextChanged="Filter_Changed"
                                         AutomationProperties.Name="{local:Tr '차단 목록 찾기'}"/>
                                <TextBlock x:Name="BlockedFilterHint" Text="{local:Tr '이름으로 찾기'}" Style="{StaticResource MutedText}" FontSize="12" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock Text="{local:Tr '차단 목록'}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BlockedCount" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="BlockedEmpty" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                   Text="{local:Tr '아직 없어요. 카드를 우클릭하면 그 아티스트나 레이블 전체를 추천에서 뺄 수 있어요.'}"/>
                        <StackPanel x:Name="BlockedNoResults" Visibility="Collapsed" Margin="0,4,0,8">
                            <TextBlock Text="{local:Tr '검색 결과가 없어요.'}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            <Button Content="{local:Tr '검색어 지우기'}" Style="{StaticResource Bare}" Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ClearBlockedFilter_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="BlockedPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
