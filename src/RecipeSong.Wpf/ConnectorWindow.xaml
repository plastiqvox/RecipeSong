<Window x:Class="RecipeSong.Wpf.ConnectorWindow" Icon="/Assets/logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RecipeSong.Wpf"
        Title="{local:Tr 'AI 커넥터 설정'}" Width="900" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Sans}">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <!-- 버튼 줄은 아래에 고정하고 본문만 스크롤 (내용이 화면보다 길면 버튼이 화면 밖으로 나가서) -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="28,14,28,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Bare}" Padding="18,8" IsCancel="True">
                    <TextBlock Text="{local:Tr '취소'}" Foreground="{StaticResource Text2}"/>
                </Button>
                <Button Style="{StaticResource Bare}" Padding="18,8" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"
                        Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}">
                    <TextBlock Text="{local:Tr '저장'}" Foreground="{StaticResource OnAccent}" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24">
                <TextBlock Text="{local:Tr 'AI 커넥터'}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{local:Tr 'AI가 웹을 검색해 내 레시피 취향에 맞을 만한 신보를 더 찾아 줍니다. 켜 둔 커넥터가 동시에 찾고, 카드에 Claude · GPT 배지가 붙어요. 찾은 앨범은 Deezer에서 실제로 있는지 확인한 뒤, 지금처럼 소리를 듣고 판정합니다.'}"/>

                <!-- Claude · GPT 를 한 화면에 이어 두면 창이 화면보다 길어서 탭으로 하나씩 -->
                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}" Margin="0,20,0,0">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource Segment}" GroupName="conn" Content="Claude (Anthropic)" IsChecked="True" Checked="ShowClaude_Checked"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="conn" Content="GPT (OpenAI)" Checked="ShowGpt_Checked"/>
                    </UniformGrid>
                </Border>

                <StackPanel x:Name="ClaudePane">
                <!-- 두 칸: 한 줄로 이어 두면 창이 화면만큼 길쭉해서 폭을 넓히고 나눴다 -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="49"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Width="1" Background="{StaticResource Line2}" Margin="0,24,0,0"/>
                    <StackPanel Grid.Column="0">
                <CheckBox x:Name="EnabledBox" Margin="0,14,0,0" Foreground="{StaticResource Text}" FontSize="14" Content="{local:Tr 'Claude 커넥터 사용'}"/>

                <!-- 연결 테스트는 키를 확인하는 것이라 키 제목 줄 오른쪽에 (따로 한 줄을 차지하지 않게) -->
                <DockPanel Margin="0,16,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Bare}" Padding="12,4" Click="Test_Click" x:Name="TestButton">
                        <TextBlock Text="{local:Tr 'Claude 연결 테스트'}" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </Button>
                    <TextBlock Text="{local:Tr 'Anthropic API 키'}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- 키가 없을 때: 발급 안내 -->
                <Border x:Name="Guide" Padding="16,14" Margin="0,0,0,10" CornerRadius="10" Background="{StaticResource AccentDeep}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'API 키 받는 법 (3분)'}" FontWeight="Bold" Foreground="{StaticResource AccentText}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="{local:Tr '1. Anthropic 콘솔에 가입하거나 로그인해요 (Claude 계정과 따로예요).'}"/><LineBreak/>
                            <Run Text="{local:Tr '2. 결제(Billing)에서 크레딧을 충전해요. $5면 수십 번 넉넉히 써요.'}"/><LineBreak/>
                            <Run Text="{local:Tr '3. API Keys에서 Create Key → 이름 \'RecipeSong\' → 나온 키를 복사해요.'}"/><LineBreak/>
                            <Run Text="{local:Tr '4. 이 창으로 돌아오면 복사한 키를 자동으로 넣어 드려요.'}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Bare}" Padding="12,6" Click="OpenKeys_Click" BorderBrush="{StaticResource Accent}">
                                <TextBlock Text="{local:Tr 'API 키 페이지 열기'}" Foreground="{StaticResource AccentText}" FontWeight="Medium"/>
                            </Button>
                            <Button Style="{StaticResource Bare}" Padding="12,6" Margin="8,0,0,0" Click="OpenBilling_Click">
                                <TextBlock Text="{local:Tr '결제 페이지 열기'}" Foreground="{StaticResource Text2}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 저장한 키는 보여 주지 않으니 빈 칸이 "키 없음"처럼 보이지 않게 안쪽에 표시 -->
                <Grid>
                    <PasswordBox x:Name="KeyBox" Style="{StaticResource Field}" AutomationProperties.Name="{local:Tr 'API 키'}"/>
                    <TextBlock x:Name="KeyStored" Text="{local:Tr '저장한 키 사용 중 ••••••••'}" Style="{StaticResource MutedText}" FontSize="13"
                               Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="ClearKey" DockPanel.Dock="Right" Style="{StaticResource Bare}" Padding="10,3" Click="ClearKey_Click">
                        <TextBlock Text="{local:Tr '저장한 키 지우기'}" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </Button>
                    <TextBlock x:Name="KeyHint" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="{local:Tr '키 유효기간'}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Width="76"/>
                    <Border Padding="3" CornerRadius="9" Background="{StaticResource Surface2}" Width="260" HorizontalAlignment="Left">
                        <UniformGrid x:Name="ClaudeKeyDaysGrid" Rows="1"/>
                    </Border>
                    <TextBlock x:Name="ClaudeKeyExpiryText" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="TestResult" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyCollapsed}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <TextBlock Text="{local:Tr '모델'}" Style="{StaticResource Kicker}" Margin="0,16,0,8"/>
                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                    <UniformGrid x:Name="ModelGrid" Rows="1"/>
                </Border>
                <TextBlock x:Name="ModelHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="{local:Tr '한 번 찾을 때 웹 검색 횟수'}" Style="{StaticResource Kicker}" Margin="0,16,0,8"/>
                <Border Padding="4" CornerRadius="10" Background="{StaticResource Surface2}">
                    <UniformGrid x:Name="SearchGrid" Rows="1"/>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{local:Tr '많을수록 넓게 찾지만 오래 걸리고 비용이 늘어요. 같은 기간·지역 결과는 7일 동안 저장해 두고 다시 쓰지 않아요.'}"/>

                <TextBlock Text="{local:Tr 'Claude 사용 한도 (USD, 비우면 없음)'}" Style="{StaticResource Kicker}" Margin="0,16,0,8"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{local:Tr '하루'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClaudeDailyBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'Claude 하루 한도'}"/>
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="{local:Tr '일주일 (월요일부터)'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClaudeWeeklyBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'Claude 주간 한도'}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="{local:Tr '충전한 크레딧'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClaudeCreditBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'Claude 충전액'}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="ClaudeUsageText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </StackPanel>

                <!-- ===== GPT (OpenAI) ===== -->
                <StackPanel x:Name="GptPane" Visibility="Collapsed">
                <!-- 두 칸: 한 줄로 이어 두면 창이 화면만큼 길쭉해서 폭을 넓히고 나눴다 -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="49"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Width="1" Background="{StaticResource Line2}" Margin="0,24,0,0"/>
                    <StackPanel Grid.Column="0">
                <CheckBox x:Name="GptEnabledBox" Margin="0,14,0,0" Foreground="{StaticResource Text}" FontSize="14" Content="{local:Tr 'GPT 커넥터 사용'}"/>

                <DockPanel Margin="0,16,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Bare}" Padding="12,4" Click="GptTest_Click" x:Name="GptTestButton">
                        <TextBlock Text="{local:Tr 'GPT 연결 테스트'}" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </Button>
                    <TextBlock Text="{local:Tr 'OpenAI API 키'}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                </DockPanel>
                <Border x:Name="GptGuide" Padding="16,14" Margin="0,0,0,10" CornerRadius="10" Background="{StaticResource GptDeep}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr 'API 키 받는 법'}" FontWeight="Bold" Foreground="{StaticResource GptBrush}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="{local:Tr '1. OpenAI 플랫폼에 로그인해요 (ChatGPT 구독과 따로 결제돼요).'}"/><LineBreak/>
                            <Run Text="{local:Tr '2. Billing에서 크레딧을 충전해요.'}"/><LineBreak/>
                            <Run Text="{local:Tr '3. API keys → Create new secret key → 나온 키(sk-...)를 복사해요.'}"/><LineBreak/>
                            <Run Text="{local:Tr '4. 이 창으로 돌아오면 자동으로 넣어 드려요.'}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Bare}" Padding="12,6" Click="OpenGptKeys_Click" BorderBrush="{StaticResource GptBrush}">
                                <TextBlock Text="{local:Tr 'API 키 페이지 열기'}" Foreground="{StaticResource GptBrush}" FontWeight="Medium"/>
                            </Button>
                            <Button Style="{StaticResource Bare}" Padding="12,6" Margin="8,0,0,0" Click="OpenGptBilling_Click">
                                <TextBlock Text="{local:Tr '결제 페이지 열기'}" Foreground="{StaticResource Text2}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 저장한 키는 보여 주지 않으니 빈 칸이 "키 없음"처럼 보이지 않게 안쪽에 표시 -->
                <Grid>
                    <PasswordBox x:Name="GptKeyBox" Style="{StaticResource Field}" AutomationProperties.Name="{local:Tr 'OpenAI API 키'}"/>
                    <TextBlock x:Name="GptKeyStored" Text="{local:Tr '저장한 키 사용 중 ••••••••'}" Style="{StaticResource MutedText}" FontSize="13"
                               Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="GptClearKey" DockPanel.Dock="Right" Style="{StaticResource Bare}" Padding="10,3" Click="GptClearKey_Click">
                        <TextBlock Text="{local:Tr '저장한 키 지우기'}" FontSize="12" Foreground="{StaticResource Text2}"/>
                    </Button>
                    <TextBlock x:Name="GptKeyHint" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="{local:Tr '키 유효기간'}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Width="76"/>
                    <Border Padding="3" CornerRadius="9" Background="{StaticResource Surface2}" Width="260" HorizontalAlignment="Left">
                        <UniformGrid x:Name="GptKeyDaysGrid" Rows="1"/>
                    </Border>
                    <TextBlock x:Name="GptKeyExpiryText" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="GptTestResult" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyCollapsed}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                <TextBlock Text="{local:Tr '모델 ID'}" Style="{StaticResource Kicker}" Margin="0,16,0,8"/>
                <TextBox x:Name="GptModelBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'GPT 모델'}"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{local:Tr '웹 검색을 지원하는 모델이어야 해요 (예: gpt-5). 새 모델이 나오면 여기서 바꾸면 돼요.'}"/>

                <TextBlock Text="{local:Tr 'GPT 사용 한도 (USD, 비우면 없음)'}" Style="{StaticResource Kicker}" Margin="0,16,0,8"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{local:Tr '하루'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="GptDailyBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'GPT 하루 한도'}"/>
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="{local:Tr '일주일 (월요일부터)'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="GptWeeklyBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'GPT 주간 한도'}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="{local:Tr '충전한 크레딧'}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="GptCreditBox" Style="{StaticResource Field}" CaretBrush="{StaticResource Text}" AutomationProperties.Name="{local:Tr 'GPT 충전액'}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="GptUsageText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
