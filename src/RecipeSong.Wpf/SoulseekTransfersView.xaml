<UserControl x:Class="RecipeSong.Wpf.SoulseekTransfersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RecipeSong.Wpf"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Sans}">
    <UserControl.Resources><ResourceDictionary Source="SoulseekStyles.xaml"/></UserControl.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TransferTitle" Text="{local:Tr '다운로드'}" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,12,0,12"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" Margin="0,10,0,0"/>
        <TabControl x:Name="TransferTabs" SelectedIndex="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
            <TabItem Header="{local:Tr '다운로드'}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*" MinWidth="280"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="{local:Tr '앨범 목록'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="RetryButton" Style="{StaticResource Bare}" Content="{local:Tr '다시 시도'}" Click="RetryJob_Click" Padding="10,6" Margin="0,0,6,6" Visibility="Collapsed"/>
                        <Button x:Name="SearchAgainButton" Style="{StaticResource Bare}" Content="{local:Tr '다른 상대 찾기'}" Click="SearchAgain_Click" Padding="10,6" Margin="0,0,6,6"/>
                        <Button x:Name="MoreButton" Style="{StaticResource UtilityIconButton}" Click="More_Click" Margin="0,0,6,6" ToolTip="{local:Tr '앨범 작업 더보기'}" AutomationProperties.Name="{local:Tr '앨범 작업 더보기'}">
                            <Path Style="{StaticResource UtilityIcon}" Data="{StaticResource MoreIcon}" StrokeThickness="0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AlbumMenu">
                                    <MenuItem x:Name="FavoriteMenu" Header="{local:Tr '즐겨찾기 등록'}" Click="Favorite_Click"/>
                                    <MenuItem x:Name="FolderMenu" Header="{local:Tr '폴더 열기'}" Click="OpenFolder_Click">
                                        <MenuItem.Icon><Path Data="{StaticResource FolderIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Text2}" StrokeThickness="1.6" StrokeLineJoin="Round"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ArtworkMenu" Header="{local:Tr '앨범아트 바꿔 재처리'}" Click="ChangeArt_Click"/>
                                    <MenuItem x:Name="CleanupMenu" Header="{local:Tr '파일 정리 재시도'}" Click="Cleanup_Click"/>
                                    <Separator x:Name="TaskMenuSeparator"/>
                                    <MenuItem x:Name="StopAlbumMenu" Header="{local:Tr '중단·파일 삭제'}" Click="CancelJob_Click"/>
                                    <MenuItem x:Name="DeleteHistoryMenu" Header="{local:Tr '선택 기록 삭제'}" Click="DeleteHistory_Click"/>
                                    <Separator x:Name="HistoryMenuSeparator"/>
                                    <MenuItem Header="{local:Tr '종료 기록 모두 삭제'}" Click="ClearHistory_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                    <ListBox x:Name="JobsList" SelectionChanged="Album_Changed" AutomationProperties.Name="{local:Tr '앨범 다운로드 작업'}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="Loaded" Handler="JobRow_Loaded"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FavoriteDisplay}" Foreground="{StaticResource AccentText}" FontSize="12" Visibility="{Binding FavoriteDisplay, Converter={StaticResource EmptyCollapsed}}"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                            <ProgressBar Style="{StaticResource Progress}" Value="{Binding Percent, Mode=OneWay}" Margin="0,7,0,0"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Focusable="True" KeyboardIncrement="10" AutomationProperties.Name="{local:Tr '다운로드 패널 너비 조절'}" ToolTip="{local:Tr '다운로드 패널 너비 조절'}"/>
                    <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{local:Tr '다운로드 상태'}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedAlbumText" Text="{local:Tr '왼쪽에서 앨범을 선택하세요.'}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="DownloadsList" AutomationProperties.Name="{local:Tr '파일 다운로드 전송'}"><ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding QueueStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" FontSize="12" Margin="0,5,0,0" Visibility="{Binding QueueStatus, Converter={StaticResource EmptyCollapsed}}"/>
                        <TextBlock Text="{Binding RewaitText}" TextWrapping="Wrap" Foreground="{StaticResource AccentText}" FontSize="12" Margin="0,5,0,0" Visibility="{Binding RewaitText, Converter={StaticResource EmptyCollapsed}}"/>
                        <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentText}" FontSize="12" Margin="0,4,0,0"/>
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,0"/>
                        <Expander Header="{local:Tr '다운로드 상세 정보'}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Information}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,6,0,0"/>
                        </Expander>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{local:Tr '업로드'}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="UploadInfoText" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UploadEmptyText" Text="{local:Tr '아직 업로드 요청이 없어요. 요청이 오면 상대 사용자·파일·진행 상태가 여기에 표시돼요.'}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Bare}" Content="{local:Tr '선택 업로드 취소'}" Click="CancelUpload_Click" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <ListBox x:Name="UploadsList" AutomationProperties.Name="{local:Tr '업로드 전송'}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                            <ProgressBar Style="{StaticResource Progress}" Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,0"/>
                            <Expander Header="{local:Tr '업로드 상세 정보'}" IsExpanded="True" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Information}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,6,0,0"/>
                            </Expander>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
