<UserControl x:Class="RecipeSong.Wpf.DownloadCacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RecipeSong.Wpf">
    <StackPanel>
        <TextBlock Text="{local:Tr '패키지·모델 캐시'}" Style="{StaticResource Kicker}" Margin="0,20,0,8"/>
        <TextBlock x:Name="CachePath" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="CacheSizes" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="{local:Tr '자동으로 비우지 않아요. 이 앱 전용 캐시만 정리하며 취향 모델·곡 분석·추천 기록·공용 캐시는 보존해요.'}"
                   Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8"/>
        <WrapPanel x:Name="Actions">
            <Button Content="{local:Tr '용량 새로고침'}" Style="{StaticResource Bare}" Padding="10,6" Margin="0,0,6,6" Click="Refresh_Click"/>
            <Button Content="{local:Tr '위치 바꾸기…'}" Style="{StaticResource Bare}" Padding="10,6" Margin="0,0,6,6" Click="Move_Click"/>
            <Button Content="{local:Tr '다음 실행 때 비우기'}" Style="{StaticResource Bare}" Padding="10,6" Margin="0,0,0,6" Click="Clear_Click"/>
            <Button x:Name="CancelPendingButton" Content="{local:Tr '예약 취소'}" Style="{StaticResource Bare}" Padding="10,6" Margin="6,0,0,6" Click="CancelPending_Click" Visibility="Collapsed"/>
        </WrapPanel>
        <TextBlock x:Name="Result" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AccentText}"/>
    </StackPanel>
</UserControl>
