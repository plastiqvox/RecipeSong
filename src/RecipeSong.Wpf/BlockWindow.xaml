<Window x:Class="RecipeSong.Wpf.BlockWindow" Icon="/Assets/logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RecipeSong.Wpf"
        Title="{local:Tr '차단'}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Sans}">
    <StackPanel Margin="26,22">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Sub" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="{local:Tr '소리 때문이에요'}" Style="{StaticResource Kicker}" Margin="0,20,0,2"/>
        <TextBlock Text="{local:Tr '이 앨범을 관심 없음으로 학습해요. 비슷한 소리의 다른 발매작도 덜 추천해요.'}" Style="{StaticResource MutedText}" FontSize="12"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>
        <WrapPanel x:Name="SoundPanel"/>

        <TextBlock Text="{local:Tr '다른 이유예요'}" Style="{StaticResource Kicker}" Margin="0,18,0,2"/>
        <TextBlock Text="{local:Tr '추천에서 빼기만 하고 학습하지 않아요.'}" Style="{StaticResource MutedText}" FontSize="12"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>
        <WrapPanel x:Name="OtherPanel"/>
        <TextBlock x:Name="SameNameHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="{local:Tr '이름만 같은 다른 아티스트: 이 Deezer 아티스트만 막아요. 같은 이름의 진짜 아티스트 발매작은 그대로 나와요.'}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Bare}" Padding="18,8" IsCancel="True">
                <TextBlock Text="{local:Tr '취소'}" Foreground="{StaticResource Text2}"/>
            </Button>
            <Button x:Name="OkButton" Style="{StaticResource Bare}" Padding="18,8" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}">
                <TextBlock Text="{local:Tr '차단'}" Foreground="{StaticResource OnAccent}" FontWeight="Bold"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
